  "query": "\n        SELECT id, account_id, folder_id, uid, uidvalidity,\n               kind, intent, state, seq, base_version,\n               attempts, error_kind, error_message, created_at, updated_at\n        FROM mail_operation\n        WHERE account_id = ?\n          AND state IN ('queued', 'running', 'retryable', 'uncertain')\n        ORDER BY seq ASC\n        ",
