# 默认按文本处理，仓库内统一使用 LF
* text=auto eol=lf

# Windows 批处理脚本必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.p12 binary
